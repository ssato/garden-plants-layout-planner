{
  "name": "garden-plants-layout-planner.git",
  "version": "1.0.0",
  "description": "Garden Layout & Plant Manager is a lightweight web application built with Google Apps Script and Konva.js.",
  "main": "index.js",
  "scripts": {
    "build:server": "esbuild src/server/main.ts --bundle --outfile=dist/code.js --format=iife --global-name=_entry",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "deploy": "npm run build && clasp push",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssato/garden-plants-layout-planner.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ssato/garden-plants-layout-planner/issues"
  },
  "homepage": "https://github.com/ssato/garden-plants-layout-planner#readme",
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.15",
    "esbuild": "^0.28.2",
    "konva": "^10.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
